{%- doc -%}
  Shared JSON payload for the embroidery configurator.

  @param {object} [p] - Product to customize (blank = demo mode)
  @param {object} s - block.settings or section.settings
  @param {string} model_source - Where bundled garment models live: 'theme' (theme assets) or 'app' (served by the app)
{%- enddoc -%}

{%- liquid
  # Garment slots: slot 1 is the block/section product; sections can add up to 3 more garments
  # (product_2..4 + model_profile_2..4). Each slot gets its own 3D model:
  # product 3D media (GLB) → model URL override (slot 1 only) → the bundled calibrated model.
  assign proxy = s.proxy_path | default: '/apps/embroidery'
  capture garments_json
    assign first = true
    for i in (1..4)
      if i == 1
        assign gp = p
        assign gid = s.model_profile | default: 'crew-tee'
      else
        assign pkey = 'product_' | append: i
        assign mkey = 'model_profile_' | append: i
        assign gp = s[pkey]
        assign gid = s[mkey] | default: 'crew-tee'
        if gp == blank
          continue
        endif
      endif
      if gid == 'tshirt-v1'
        assign gid = 'crew-tee'
      endif

      assign gurl = ''
      if s.use_product_model and gp != blank
        for media in gp.media
          if media.media_type == 'model'
            for source in media.sources
              if source.format == 'glb'
                assign gurl = source.url
                break
              endif
            endfor
            break
          endif
        endfor
      endif
      if gurl == blank and i == 1
        assign gurl = s.model_url | strip
      endif
      if gurl == blank
        if model_source == 'app'
          assign gurl = proxy | append: '/model/' | append: gid | append: '.glb'
        else
          assign gurl = 'embroidery-' | append: gid | append: '.glb' | asset_url
        endif
      endif
      if i == 1
        assign model_url = gurl
        assign model_id = gid
      endif

      unless first
        echo ','
      endunless
      assign first = false
      echo '{"modelId": '
      echo gid | json
      echo ', "modelUrl": '
      echo gurl | json
      echo ', "selectedVariantId": '
      if gp != blank
        echo gp.selected_or_first_available_variant.id | json
        echo ', "product": '
        render 'embroidery-product-json', product: gp
      else
        echo 'null, "product": null'
      endif
      echo '}'
    endfor
  endcapture

  # App blocks allow one product picker, so the fee product can also be given by handle.
  assign fee_product = s.fee_product
  if fee_product == blank and s.fee_product_handle != blank
    assign fee_product = all_products[s.fee_product_handle]
  endif

  assign positions = ''
  if s.pos_left_chest
    assign positions = positions | append: 'left_chest,'
  endif
  if s.pos_center_chest
    assign positions = positions | append: 'center_chest,'
  endif
  if s.pos_right_chest
    assign positions = positions | append: 'right_chest,'
  endif
  if s.pos_upper_back
    assign positions = positions | append: 'upper_back,'
  endif
  if s.pos_center_back
    assign positions = positions | append: 'center_back,'
  endif
  assign positions = positions | split: ','
  assign threads = s.thread_colors | remove: ' ' | split: ','
-%}
<script type="application/json" data-embroidery-config>
  {
    "product": {% if p != blank %}{% render 'embroidery-product-json', product: p %}{% else %}null{% endif %},
    "garments": [{{ garments_json }}],
    "selectedVariantId": {% if p != blank %}{{ p.selected_or_first_available_variant.id | json }}{% else %}null{% endif %},
    "currency": {{ cart.currency.iso_code | json }},
    "locale": {{ request.locale.iso_code | json }},
    "root": {{ routes.root_url | json }},
    "shopUrl": {{ shop.url | json }},
    "modelUrl": {{ model_url | json }},
    "modelId": {{ model_id | json }},
    "proxyPath": {{ proxy | json }},
    "display": {{ s.display | default: 'inline' | json }},
    "buttonLabel": {{ s.button_label | json }},
    "syncThemeVariant": {{ s.sync_theme_variant | json }},
    "samplePrices": {{ s.sample_prices | json }},
    "bulkTiers": {{ s.bulk_tiers | json }},
    "feeVariants": [
      {%- if fee_product != blank -%}
        {%- for v in fee_product.variants -%}
          {"title": {{ v.title | json }}, "price": {{ v.price | json }}, "id": {{ v.id | json }}, "available": {{ v.available | json }}}
          {%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      {%- endif -%}
    ],
    "settings": {
      "theme": {{ s.design_theme | default: 'clean' | json }},
      "themeSwitcher": {{ s.show_style_switcher | default: false | json }},
      "heading": {{ s.heading | json }},
      "subtitle": {{ s.subtitle | json }},
      "defaultText": {{ s.default_text | json }},
      "defaultPositionId": {{ s.default_position | json }},
      "positionIds": {{ positions | json }},
      "threadColorIds": {{ threads | json }},
      "maxUploadMb": {{ s.max_upload_mb | default: 5 | json }},
      "garmentColors": {{ s.garment_colors | json }},
      "afterAdd": {{ s.after_add | default: 'stay' | json }},
      "maxDesigns": {{ s.max_designs | default: 4 | json }},
      "teamOrders": {{ s.enable_team_orders | json }},
      "sharing": {{ s.enable_sharing | json }},
      "templates": {{ s.enable_templates | json }},
      "defaultGarmentColor": {{ s.default_garment_color | json }},
      "defaultThreadColorId": {{ s.default_thread_color | json }}
    }
  }
</script>
