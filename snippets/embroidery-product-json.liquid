{%- doc -%}
  A product as JSON for the embroidery configurator (fields it needs only).

  @param {object} product - The product to serialize
{%- enddoc -%}
{"id": {{ product.id | json }}, "title": {{ product.title | json }}, "handle": {{ product.handle | json }}, "options": {{ product.options | json }}, "variants": [
  {%- for v in product.variants -%}
    {"id": {{ v.id | json }}, "title": {{ v.title | json }}, "options": {{ v.options | json }}, "available": {{ v.available | json }}, "price": {{ v.price | json }}}{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
]}
