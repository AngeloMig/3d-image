{%- comment -%}
  Product-page app block (also works on the homepage or any template: choose a product in the
  block settings). The 3D customizer is lazy-loaded when the block scrolls into view.
{%- endcomment -%}
{%- liquid
  assign p = block.settings.product
  if p == blank
    assign p = product
  endif
-%}
<div
  class="embroidery-customizer-block"
  data-embroidery-root
  data-module-src="{{ 'embroidery-configurator.js' | asset_url }}"
  {{ block.shopify_attributes }}
>
  {% render 'embroidery-config', p: p, s: block.settings, model_source: 'app' %}
  <div class="embroidery-customizer-block__placeholder" aria-hidden="true"></div>
  <p data-embroidery-fallback hidden>{{ 'embroidery.load_error' | t }}</p>
  <noscript>{{ 'embroidery.noscript' | t }}</noscript>
  {%- if request.design_mode and p == blank -%}
    <p class="embroidery-customizer-block__editor-note">{{ 'embroidery.choose_product' | t }}</p>
  {%- endif -%}
</div>
<style>
  .embroidery-customizer-block { display: block; margin: 1.5rem 0; }
  .embroidery-customizer-block:not([data-embroidery-state='ready']) .embroidery-customizer-block__placeholder {
    min-height: {% if block.settings.display == 'button' %}52px{% else %}min(80vh, 640px){% endif %};
    border-radius: 14px;
    background: linear-gradient(100deg, #f1eee7 30%, #f8f6f1 50%, #f1eee7 70%) 0 0 / 200% 100%;
    animation: embroidery-shimmer 1.4s linear infinite;
  }
  .embroidery-customizer-block[data-embroidery-state='ready'] .embroidery-customizer-block__placeholder { display: none; }
  .embroidery-customizer-block__editor-note { padding: .75rem 1rem; border: 1px dashed currentColor; border-radius: 8px; }
  @keyframes embroidery-shimmer { to { background-position: -200% 0; } }
  @media (prefers-reduced-motion: reduce) { .embroidery-customizer-block__placeholder { animation: none; } }
</style>

{% schema %}
{
  "name": "Embroidery customizer",
  "target": "section",
  "javascript": "embroidery-loader.js",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Leave empty on product pages to use the current product. Required on the homepage and other pages." },
    { "type": "select", "id": "display", "label": "Display", "default": "inline", "options": [
      { "value": "inline", "label": "Inline (full customizer on the page)" },
      { "value": "button", "label": "Button that opens a full-screen customizer" }
    ], "info": "Use the button option inside narrow product-info columns." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Personalize with embroidery" },
    { "type": "select", "id": "design_theme", "label": "Design style", "default": "clean", "options": [
      { "value": "clean", "label": "Clean — subtle, uses your theme font" },
      { "value": "sport", "label": "Sport — bold, athletic, black & white" },
      { "value": "atelier", "label": "Atelier — warm, premium, serif" }
    ] },
    { "type": "checkbox", "id": "show_style_switcher", "label": "Let visitors switch design style (client preview)", "default": false, "info": "Shows a Clean / Sport / Atelier switch on the customizer. Turn off before launch." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Make it yours." },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Add a name, initials or your logo — see it stitched onto the garment in 3D before you order." },
    { "type": "text", "id": "default_text", "label": "Default embroidery text", "default": "YOUR NAME" },
    { "type": "header", "content": "Embroidery positions" },
    { "type": "checkbox", "id": "pos_left_chest", "label": "Left chest", "default": true },
    { "type": "checkbox", "id": "pos_center_chest", "label": "Center chest", "default": true },
    { "type": "checkbox", "id": "pos_right_chest", "label": "Right chest", "default": true },
    { "type": "checkbox", "id": "pos_upper_back", "label": "Upper back", "default": true },
    { "type": "checkbox", "id": "pos_center_back", "label": "Center back", "default": true },
    { "type": "select", "id": "default_position", "label": "Default position", "default": "left_chest", "options": [
      { "value": "left_chest", "label": "Left chest" },
      { "value": "center_chest", "label": "Center chest" },
      { "value": "right_chest", "label": "Right chest" },
      { "value": "upper_back", "label": "Upper back" },
      { "value": "center_back", "label": "Center back" }
    ] },
    { "type": "header", "content": "Thread and garment colours" },
    { "type": "text", "id": "thread_colors", "label": "Thread colours offered", "info": "Leave empty to offer all 20 colours, or list ids (first = default): white, black, cream, silver, charcoal, navy, royal, sky, teal, forest, kelly, olive, gold, yellow, orange, red, burgundy, blush, fuchsia, purple." },
    { "type": "text", "id": "default_garment_color", "label": "Default garment colour", "default": "White", "info": "Colour option value the customizer starts on (unless the shopper chose a variant)." },
    { "type": "select", "id": "default_thread_color", "label": "Default thread colour", "default": "red", "options": [{"value": "black", "label": "Black"}, {"value": "white", "label": "White"}, {"value": "cream", "label": "Cream"}, {"value": "silver", "label": "Silver Grey"}, {"value": "charcoal", "label": "Charcoal"}, {"value": "navy", "label": "Navy"}, {"value": "royal", "label": "Royal Blue"}, {"value": "sky", "label": "Sky Blue"}, {"value": "teal", "label": "Teal"}, {"value": "forest", "label": "Forest Green"}, {"value": "kelly", "label": "Kelly Green"}, {"value": "olive", "label": "Olive"}, {"value": "gold", "label": "Gold"}, {"value": "yellow", "label": "Sun Yellow"}, {"value": "orange", "label": "Orange"}, {"value": "red", "label": "Red"}, {"value": "burgundy", "label": "Burgundy"}, {"value": "blush", "label": "Blush Pink"}, {"value": "fuchsia", "label": "Fuchsia"}, {"value": "purple", "label": "Purple"}] },
    { "type": "textarea", "id": "garment_colors", "label": "Garment colour map", "default": "Royal: #2c4aa6\nWhite: #f1f1ee\nBlack: #232325\nNavy: #24304f\nBeige: #d9c8a9", "info": "One per line: <colour option value>: <hex>. Use 'original' to keep the 3D model's own texture colour." },
    { "type": "header", "content": "3D model" },
    { "type": "checkbox", "id": "use_product_model", "label": "Use the product's 3D model media (GLB) when available", "default": true },
    { "type": "text", "id": "model_url", "label": "Model URL override", "info": "Optional GLB URL (e.g. uploaded to Content → Files). Empty = the garment model served by the app." },
    { "type": "select", "id": "model_profile", "label": "Garment (3D model)", "default": "crew-tee", "options": [
      { "value": "crew-tee", "label": "Classic T-shirt" },
      { "value": "sport-tee", "label": "Sport T-shirt" },
      { "value": "polo", "label": "Polo shirt" },
      { "value": "long-sleeve", "label": "Long-sleeve T-shirt" }
    ], "info": "Embroidery positions are calibrated per model; pick the one matching this product." },
    { "type": "header", "content": "Pricing & extra features" },
    { "type": "text", "id": "fee_product_handle", "label": "Embroidery fee product (handle)", "placeholder": "embroidery-fee", "info": "The handle of a product with variants named after each fee: Text, Logo, Medium size, Large size, 3D Puff, Metallic thread, Woven patch, Chenille, Premium font. Their Shopify prices are shown live and added to the cart." },
    { "type": "textarea", "id": "sample_prices", "label": "Sample add-on prices (preview only)", "default": "Text: 5\nLogo: 8\nMedium size: 3\nLarge size: 6\n3D Puff: 4\nMetallic thread: 3\nWoven patch: 6\nChenille: 7\nPremium font: 2", "info": "Shown only while no Embroidery fee product is selected, labelled 'not charged yet'. Amounts in your store currency. Clear it to hide prices." },
    { "type": "textarea", "id": "bulk_tiers", "label": "Bulk discount tiers", "info": "One per line: <minimum items>: <% off garments>, e.g. 10: 10. Shown live in the customizer. Create matching automatic discounts in Discounts so Shopify charges them." },
    { "type": "range", "id": "max_designs", "label": "Designs per item", "min": 1, "max": 4, "step": 1, "default": 4, "info": "e.g. names and logos on both chests and the back. Overlapping spots can't be combined." },
    { "type": "checkbox", "id": "enable_team_orders", "label": "Allow team / bulk orders (a different name per shirt)", "default": true },
    { "type": "checkbox", "id": "enable_sharing", "label": "Allow saving and sharing designs by link", "default": true },
    { "type": "checkbox", "id": "enable_templates", "label": "Offer ready-made design templates (team jersey, monogram…)", "default": true },
    { "type": "header", "content": "Behaviour" },
    { "type": "range", "id": "max_upload_mb", "label": "Max logo upload size", "min": 1, "max": 10, "step": 1, "unit": "MB", "default": 5 },
    { "type": "select", "id": "after_add", "label": "After adding to cart", "default": "stay", "options": [
      { "value": "stay", "label": "Stay on page and confirm" },
      { "value": "cart", "label": "Go to the cart" }
    ] },
    { "type": "checkbox", "id": "sync_theme_variant", "label": "Follow the theme's variant picker", "default": true },
    { "type": "text", "id": "proxy_path", "label": "App proxy path", "default": "/apps/embroidery", "info": "Must match the app proxy configured for the app." }
  ]
}
{% endschema %}
