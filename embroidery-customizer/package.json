{
  "name": "embroidery-customizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "extensions/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "shopify app dev",
    "build": "npm run extension:build && react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "setup": "prisma generate && prisma migrate deploy",
    "docker-start": "npm run setup && npm run start",
    "deploy": "npm run extension:build && shopify app deploy",
    "config:link": "shopify app config link",
    "shopify": "shopify",
    "prisma": "prisma",
    "demo": "npm run dev -w @embroidery/demo",
    "demo:build": "npm run build -w @embroidery/demo",
    "demo:preview": "npm run preview -w @embroidery/demo",
    "model:optimize": "node scripts/optimize-model.mjs",
    "extension:build": "node scripts/build-storefront.mjs",
    "theme:build": "node scripts/build-storefront.mjs --theme",
    "typecheck": "tsc -p tsconfig.json --noEmit && react-router typegen && tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run demo:build && npm run extension:build && react-router build",
    "cleanup:artwork": "tsx scripts/cleanup-artwork.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/graduate": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@gltf-transform/cli": "^4.5.1",
    "@playwright/test": "^1.64.0",
    "@preact/preset-vite": "^2.10.6",
    "@shopify/polaris-types": "^1.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "liquidjs": "^10.30.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@embroidery/shared": "0.1.0",
    "@prisma/client": "^6.19.0",
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^3.0.1",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.0",
    "isbot": "^5.1.31",
    "prisma": "^6.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2",
    "vite-tsconfig-paths": "^6.0.4"
  },
  "overrides": {
    "p-map": "^4.0.0",
    "qs": "^6.16.0"
  }
}
