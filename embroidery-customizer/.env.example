# Copy to .env (never commit real values). `shopify app dev` injects SHOPIFY_* automatically.

# --- Shopify (set by the CLI in dev; set in your host for production) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_orders

# --- Artwork storage ---
# local (dev default, NOT durable in production) | s3 (AWS S3, Cloudflare R2, MinIO)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# Required when STORAGE_DRIVER=s3. Use a PRIVATE bucket.
S3_BUCKET=
S3_REGION=
# R2: https://<account-id>.r2.cloudflarestorage.com  (and S3_REGION=auto)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Limits & retention ---
MAX_UPLOAD_MB=5
# Unordered designs/artwork older than this are removed by `npm run cleanup:artwork`
RETENTION_DAYS=30
