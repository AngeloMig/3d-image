{
  "scripts": {
    "build:css": "gulp sass",
    "build:js": "gulp js",
    "watch:css": "gulp watch",
    "dev": "gulp",
    "verify:css": "npm run build:css && git diff --check",
    "guide:build": "node scripts/build-guide-data.js",
    "guide:verify": "node scripts/build-guide-data.js --verify",
    "guide:test": "node --test scripts/guide.test.mjs",
    "guide:vendor": "node scripts/vendor-sass.js",
    "guide:docx": "node scripts/build-guide-docx.js",
    "guide:check": "npm run guide:verify && npm run guide:test",
    "postinstall": "node scripts/vendor-sass.js",
    "hooks:install": "sh scripts/install-hooks.sh"
  },
  "devDependencies": {
    "browser-sync": "^3.0.3",
    "docx": "^9.7.1",
    "gulp": "^5.0.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-rename": "^2.0.0",
    "gulp-sass": "^6.0.1",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-terser": "^2.1.0",
    "immutable": "^3.8.2",
    "sass": "^1.77.8"
  },
  "dependencies": {
    "sass-embedded": "^1.80.6"
  }
}
