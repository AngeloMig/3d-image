{%- comment -%}
  Vertical Swiper carousel from the wholesale page. The merchant manages slides
  via blocks. Swiper itself is loaded by the site (this section assumes it). The
  active-slide visual rules and the text-source -> #destination sync live as a
  per-section <style>/<script> with section.id namespacing so multiple instances
  on a page don't collide.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<style>
  #SwiperCollection-{{ section.id }} .swiper-slide.swiper-slide-active .component_collection_swiper-overlay { opacity: 0; }
  #SwiperCollection-{{ section.id }} .swiper-slide.swiper-slide-active .component_collection_img-wrap {
    transform: scale(1.5);
    box-shadow: 0px 20px 24px rgba(0, 0, 0, 0.4);
    z-index: 5;
  }
  #SwiperCollection-{{ section.id }} .swiper-slide .component_collection_item-content,
  #SwiperCollection-{{ section.id }} .swiper-slide .component_collection_name-wrap { opacity: 0; }
  #SwiperCollection-{{ section.id }} .swiper-slide.swiper-slide-active .component_collection_item-content,
  #SwiperCollection-{{ section.id }} .swiper-slide.swiper-slide-active .component_collection_name-wrap { opacity: 1; }
  #SwiperCollection-{{ section.id }} .swiper-slide.swiper-slide-active .component_collection_item-row.content {
    width: 100%; border-color: var(--color-foreground, white);
  }
</style>

<section class="component_collection_section section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="padding-global">
    <div class="container-x-large">
      <div class="component_collection_content">
        <div class="component_collection_top-wrapper">
          <div class="component_collection_name">
            <div class="component_collection_icon-wrap">
              <div class="icon-embed-xxsmall">
                <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 17 17" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true" role="img">
                  <circle cx="8.5" cy="8.5" r="8.5" fill="currentColor"></circle>
                </svg>
              </div>
            </div>
            <div id="Destination-{{ section.id }}" class="text-source">
              {%- if section.blocks.size > 0 -%}
                {{ section.blocks.first.settings.name | default: section.settings.label }}
              {%- else -%}
                {{ section.settings.label }}
              {%- endif -%}
            </div>
          </div>
        </div>

        {%- if section.blocks.size > 0 -%}
          <div id="SwiperCollection-{{ section.id }}" class="swiper is-collection swiper-vertical">
            <div class="swiper-wrapper is-collection" aria-live="polite">
              {%- for block in section.blocks -%}
                <div class="swiper-slide is-collection" role="group" aria-label="{{ forloop.index }} / {{ section.blocks.size }}" {{ block.shopify_attributes }}>
                  <div class="component_collection_item">
                    <div class="component_collection_left">
                      <a href="{{ block.settings.link | default: '#' }}" class="component_collection_item-content">
                        <div class="max-width-small">
                          {%- if block.settings.heading != blank -%}
                            <h2>{{ block.settings.heading }}</h2>
                          {%- endif -%}
                          {%- if block.settings.body != blank -%}
                            <div class="component_collection_paragraph-wrap">{{ block.settings.body }}</div>
                          {%- endif -%}
                        </div>
                      </a>
                      <div class="component_collection_item-content-right">
                        <div class="component_collection_img-wrap">
                          {%- if block.settings.image != blank -%}
                            {{
                              block.settings.image
                              | image_url: width: 1280
                              | image_tag: loading: 'lazy', widths: '500, 800, 1280', alt: block.settings.image_alt | escape
                            }}
                          {%- else -%}
                            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                          {%- endif -%}
                          <div class="component_collection_swiper-overlay"></div>
                        </div>
                      </div>
                    </div>
                    <div class="component_collection_item-grid">
                      <div class="component_collection_item-row"></div>
                      <div class="component_collection_item-row no-bottom-border"></div>
                      <div class="component_collection_item-row content">
                        <div class="component_collection_name-wrap">
                          <div class="component_collection_icon-wrap">
                            <div class="icon-embed-xxsmall">
                              <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 17 17" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true" role="img">
                                <circle cx="8.5" cy="8.5" r="8.5" fill="currentColor"></circle>
                              </svg>
                            </div>
                          </div>
                          <div class="component_collection_text text-source">{{ block.settings.name }}</div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var root = document.getElementById('SwiperCollection-{{ section.id }}');
    var dest = document.getElementById('Destination-{{ section.id }}');
    if (!root || typeof Swiper === 'undefined') return;

    new Swiper(root, {
      direction: 'vertical',
      slidesPerView: 5,
      centeredSlides: true,
      mousewheel: true,
      speed: 500,
      keyboard: { enabled: true },
      breakpoints: { 0: { direction: 'horizontal', slidesPerView: 1, spaceBetween: 16, mousewheel: false } }
    });

    function sync() {
      var active = root.querySelector('.swiper-slide-active .text-source');
      if (active && dest) dest.textContent = active.textContent;
    }
    sync();
    new MutationObserver(sync).observe(root, { attributes: true, subtree: true, attributeFilter: ['class'] });
  });
</script>

{% schema %}
{
  "name": "t:sections.wholesale-collection.name",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "t:sections.all.colors.label" },
    { "type": "text", "id": "label", "default": "SP Arms wholesale // B2B", "label": "t:sections.wholesale-collection.settings.label.label" },

    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    { "type": "range", "id": "padding_top",    "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36, "label": "t:sections.all.padding.padding_top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36, "label": "t:sections.all.padding.padding_bottom" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.wholesale-collection.blocks.slide.name",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:sections.wholesale-collection.blocks.slide.settings.image.label" },
        { "type": "text", "id": "image_alt", "label": "t:sections.wholesale-collection.blocks.slide.settings.image_alt.label" },
        { "type": "inline_richtext", "id": "heading", "default": "Slide heading", "label": "t:sections.wholesale-collection.blocks.slide.settings.heading.label" },
        { "type": "richtext", "id": "body", "default": "<p>One short sentence on the benefit.</p>", "label": "t:sections.wholesale-collection.blocks.slide.settings.body.label" },
        { "type": "text", "id": "name", "default": "SP Arms wholesale // B2B", "label": "t:sections.wholesale-collection.blocks.slide.settings.name.label" },
        { "type": "url", "id": "link", "label": "t:sections.wholesale-collection.blocks.slide.settings.link.label" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "t:sections.wholesale-collection.presets.name",
      "blocks": [
        { "type": "slide", "settings": { "heading": "Strong brand reputation", "body": "<p>Trusted by elite athletes worldwide, Sparms is a proven performance brand with global recognition and demand.</p>", "name": "Brand" } },
        { "type": "slide", "settings": { "heading": "Wholesale platform", "body": "<p>Order, replenish and grow through a seamless online wholesale platform.</p>", "name": "Platform" } },
        { "type": "slide", "settings": { "heading": "Dedicated support", "body": "<p>A team that ships and replenishes with you.</p>", "name": "Support" } }
      ]
    }
  ]
}
{% endschema %}
