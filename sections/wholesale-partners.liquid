{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="wholesale_partner_section section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="padding-global">
    <div class="container-large">
      <div class="wholesale_partner_component">
        {%- if section.settings.heading != blank -%}
          <div class="max-width-large align-center text-align-center">
            <h2 class="heading-style-h3">{{ section.settings.heading }}</h2>
          </div>
          <div class="spacer-small"></div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="wholesale_partner_grid-list">
            {%- for block in section.blocks -%}
              <div class="wholesale_partner_logo-wrap" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" aria-label="{{ block.settings.alt | default: 'Partner logo' | escape }}">
                {%- endif -%}
                {%- if block.settings.logo != blank -%}
                  {{
                    block.settings.logo
                    | image_url: width: 300
                    | image_tag: loading: 'lazy', widths: '100, 200, 300', alt: block.settings.alt | escape
                  }}
                {%- else -%}
                  {{ 'logo' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
                {%- if block.settings.link != blank -%}
                  </a>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.wholesale-partners.name",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Our partners",
      "label": "t:sections.wholesale-partners.settings.heading.label"
    },

    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    { "type": "range", "id": "padding_top",    "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36, "label": "t:sections.all.padding.padding_top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36, "label": "t:sections.all.padding.padding_bottom" }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "t:sections.wholesale-partners.blocks.logo.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "t:sections.wholesale-partners.blocks.logo.settings.logo.label"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "t:sections.wholesale-partners.blocks.logo.settings.alt.label",
          "info": "t:sections.wholesale-partners.blocks.logo.settings.alt.info"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.wholesale-partners.blocks.logo.settings.link.label"
        }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "t:sections.wholesale-partners.presets.name",
      "blocks": [
        { "type": "logo" }, { "type": "logo" }, { "type": "logo" },
        { "type": "logo" }, { "type": "logo" }, { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
